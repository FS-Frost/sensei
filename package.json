		"fsrs-browser": "^6.6.0",
		"ggwave": "^0.4.0",
		"jsqr": "^1.4.0",
		"ts-fsrs": "^5.4.2",
		"uqr": "^0.1.3",
		"wanakana": "^5.3.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
