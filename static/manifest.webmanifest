{
	"name": "Sensei — Leer japonés",
	"short_name": "Sensei",
	"description": "Aprende a leer japonés desde el español: SRS, diccionario y tutor Gemini, todo en tu navegador.",
	"start_url": ".",
	"scope": ".",
	"display": "standalone",
	"background_color": "#14161b",
	"theme_color": "#14161b",
	"lang": "es",
	"icons": [
		{ "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
		{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" },
		{ "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
	],
	"shortcuts": [
		{ "name": "Sesión de hoy", "short_name": "Hoy", "description": "Repasos, lección y lectura en una sesión guiada", "url": "hoy", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
		{ "name": "Repaso", "short_name": "Repaso", "description": "Repasos pendientes", "url": "repaso", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
		{ "name": "Lección", "short_name": "Lección", "description": "Kanji y vocabulario nuevos", "url": "leccion", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
		{ "name": "Explicador", "short_name": "Explicar", "description": "Explicar un texto o una foto", "url": "explicar", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
		{ "name": "Sincronizar", "short_name": "Sincronizar", "description": "Pasar el progreso a otro dispositivo", "url": "sincronizar", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
	],
	"share_target": {
		"action": "compartir",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{
					"name": "files",
					"accept": ["image/*", "text/plain", ".txt", ".srt", "application/x-subrip", ".epub", "application/epub+zip", ".html", "text/html", ".zip", "application/zip"]
				}
			]
		}
	},
	"file_handlers": [
		{
			"action": "compartir",
			"accept": {
				"text/plain": [".txt"],
				"application/x-subrip": [".srt"],
				"application/epub+zip": [".epub"],
				"application/zip": [".zip"]
			}
		}
	]
}
